# ==========================================
# InterviewAI Environment Configuration Template
# ==========================================

# Application Settings
PROJECT_NAME="InterviewAI"
VERSION="1.0.0"
API_V1_STR="/api"

# Security & Authentication
# In production, generate a secure 64-character secret using: openssl rand -hex 32
SECRET_KEY="interviewai-super-secret-key-for-development-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local Development (SQLite):
DATABASE_URL="sqlite:///./interviewai.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@localhost:5432/interviewai"

# AI Provider Configuration (Optional)
# If left blank, InterviewAI will seamlessly use its built-in Deterministic Placement Rubric Engine
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-flash"
AI_API_KEY=""

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

